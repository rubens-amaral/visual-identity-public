<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta base -->
  <Color x:Key="AccentColor">#4A90E2</Color>
  <Color x:Key="ErrorColor">#E74C3C</Color>
  <Color x:Key="SuccessColor">#27AE60</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>

  <!-- Fontes -->
  <!-- Família principal -->
  <FontFamily x:Key="AppFont">
    avares://Launcher/visual-identity/Assets/Fonts/OpenSans-Regular.ttf#Open Sans
  </FontFamily>

  <!-- Variações opcionais -->
  <FontFamily x:Key="AppFontSemiBold">
    avares://Launcher/visual-identity/Assets/Fonts/OpenSans-SemiBold.ttf#Open Sans SemiBold
  </FontFamily>

  <FontFamily x:Key="AppFontBold">
    avares://Launcher/visual-identity/Assets/Fonts/OpenSans-Bold.ttf#Open Sans Bold
  </FontFamily>

</ResourceDictionary>
